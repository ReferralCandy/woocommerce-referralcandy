{
    "name": "woocommerce-referralcandy",
    "version": "3.0.0",
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "build": "wp-scripts build",
        "watch": "wp-scripts start",
        "test": "wp-scripts test-unit-js",
        "test:watch": "wp-scripts test-unit-js --watch",
        "test:php": "wp-env run cli wp eval-file wp-content/plugins/woocommerce-referralcandy/tests/php/settings-test.php",
        "zip": "wp-scripts build && node scripts/package.mjs production",
        "zip:staging": "wp-scripts build && node scripts/package.mjs staging",
        "start": "wp-env start",
        "start:xdebug": "wp-env start --xdebug",
        "tunnel": "node scripts/tunnel.mjs",
        "dev": "pnpm run start && wp-env run cli wp rewrite flush --hard && pnpm run tunnel",
        "stop": "wp-env stop",
        "destroy": "wp-env destroy"
    },
    "devDependencies": {
        "@wordpress/env": "^10.39.0",
        "@wordpress/icons": "^15.4.0",
        "@wordpress/scripts": "^34.1.0",
        "adm-zip": "^0.6.0"
    }
}
